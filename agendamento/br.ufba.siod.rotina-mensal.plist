<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo: troque RAIZ_DO_PROJETO pelo caminho absoluto e copie para ~/Library/LaunchAgents/ (ver LEIA-ME.md). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>br.ufba.siod.rotina-mensal</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>RAIZ_DO_PROJETO/agendamento/rotina_mensal.sh</string></array>
  <!-- Dia 2 de cada mês, 03:00. Se o Mac estiver dormindo, o launchd roda ao acordar (o cron perderia a execução). -->
  <key>StartCalendarInterval</key><dict><key>Day</key><integer>2</integer><key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>RAIZ_DO_PROJETO/data/logs/agendamento/launchd.out</string>
  <key>StandardErrorPath</key><string>RAIZ_DO_PROJETO/data/logs/agendamento/launchd.err</string>
</dict>
</plist>
